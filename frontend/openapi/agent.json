{
  "openapi": "3.1.0",
  "info": {
    "title": "Odoo RAG - agent",
    "description": "Agentic RAG over the curated Odoo 19 developer documentation: supervisor + docs agent + research agent (LangGraph), memory per `thread_id`, linear baseline.",
    "version": "0.3.0"
  },
  "paths": {
    "/query": {
      "post": {
        "tags": [
          "query"
        ],
        "summary": "Ask a question (agentic graph or linear baseline); aggregated response",
        "operationId": "query_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "502": {
            "description": "LLM, embeddings or Qdrant failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "An upstream service timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/query/stream": {
      "post": {
        "tags": [
          "query"
        ],
        "summary": "Same as /query, streamed as Server-Sent Events (challenge C)",
        "operationId": "query_stream_query_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "`text/event-stream`: `event: <type>` + `data: <json>` per event (node_started, node_finished, token, sources, interrupt, final, error; §5.3).",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/query/resume": {
      "post": {
        "tags": [
          "query"
        ],
        "summary": "Approve or reject a pending external search (HITL, challenge D)",
        "operationId": "query_resume_query_resume_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "No pending interrupt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "LLM, embeddings or Qdrant failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "An upstream service timed out",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "post": {
        "tags": [
          "search"
        ],
        "summary": "Retrieve chunks (dense vector search with metadata filters)",
        "operationId": "search_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorInfo"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorDetail"
      },
      "ErrorInfo": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorInfo"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "description": "Body of 4xx/5xx errors raised by the services: `{\"detail\": {\"error\": {code, message}}}`."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PendingInterrupt": {
        "properties": {
          "kind": {
            "type": "string",
            "const": "confirm_external_search",
            "title": "Kind",
            "default": "confirm_external_search"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "type": "object",
        "title": "PendingInterrupt"
      },
      "QueryRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question",
            "examples": [
              "¿Cómo defino un campo computado?"
            ]
          },
          "thread_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Thread Id",
            "description": "Conversation id (memory, D-08). Null: the server generates a uuid4."
          },
          "mode": {
            "type": "string",
            "enum": [
              "agentic",
              "linear"
            ],
            "title": "Mode",
            "description": "`linear` = retrieve -> generate baseline (E-02): no memory, no grader/router.",
            "default": "agentic"
          },
          "filters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RetrievalFilters"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "question"
        ],
        "title": "QueryRequest",
        "description": "`POST /query` and `/query/stream` body (ARCHITECTURE §5.1)."
      },
      "QueryResponse": {
        "properties": {
          "thread_id": {
            "type": "string",
            "title": "Thread Id"
          },
          "run_id": {
            "type": "string",
            "title": "Run Id",
            "default": ""
          },
          "mode": {
            "type": "string",
            "enum": [
              "agentic",
              "linear"
            ],
            "title": "Mode",
            "default": "agentic"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "answered_by": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "docs",
                  "research",
                  "direct"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Answered By"
          },
          "route": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "docs",
                  "research",
                  "direct"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Route"
          },
          "delegated": {
            "type": "boolean",
            "title": "Delegated",
            "default": false
          },
          "external": {
            "type": "boolean",
            "title": "External",
            "description": "Answered from external sources (forum).",
            "default": false
          },
          "no_context": {
            "type": "boolean",
            "title": "No Context",
            "default": false
          },
          "standalone_question": {
            "type": "string",
            "title": "Standalone Question",
            "default": ""
          },
          "nodes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Nodes",
            "description": "Executed nodes, in order."
          },
          "steps": {
            "items": {
              "$ref": "#/components/schemas/StepRecord"
            },
            "type": "array",
            "title": "Steps"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceRef"
            },
            "type": "array",
            "title": "Sources"
          },
          "usage": {
            "$ref": "#/components/schemas/Usage"
          },
          "latency_ms": {
            "type": "integer",
            "title": "Latency Ms",
            "default": 0
          },
          "interrupt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PendingInterrupt"
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when the turn paused waiting for `/query/resume` (HITL)."
          }
        },
        "type": "object",
        "required": [
          "thread_id",
          "run_id",
          "mode",
          "answer",
          "answered_by",
          "route",
          "delegated",
          "external",
          "no_context",
          "standalone_question",
          "nodes",
          "steps",
          "sources",
          "usage",
          "latency_ms",
          "interrupt"
        ],
        "title": "QueryResponse",
        "description": "Aggregated result of one turn (the REST body, closing event of the SSE stream)."
      },
      "ResumeRequest": {
        "properties": {
          "thread_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._:-]+$",
            "title": "Thread Id"
          },
          "approved": {
            "type": "boolean",
            "title": "Approved"
          }
        },
        "type": "object",
        "required": [
          "thread_id",
          "approved"
        ],
        "title": "ResumeRequest",
        "description": "`POST /query/resume`: answer a pending `confirm_external_search` interrupt (challenge D)."
      },
      "RetrievalFilters": {
        "properties": {
          "doc_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doc Ids"
          },
          "sources": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sources"
          }
        },
        "type": "object",
        "title": "RetrievalFilters",
        "description": "Metadata filters applied to payload indexes in Qdrant (V-03)."
      },
      "ScoredChunk": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "title": "Chunk Id"
          },
          "doc_id": {
            "type": "string",
            "title": "Doc Id"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "anchor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Anchor"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page",
            "description": "PDF page number; null otherwise."
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "doc_id",
          "score",
          "text",
          "title",
          "url"
        ],
        "title": "ScoredChunk"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Query"
          },
          "top_k": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Top K",
            "default": 10
          },
          "filters": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RetrievalFilters"
              },
              {
                "type": "null"
              }
            ]
          },
          "exact": {
            "type": "boolean",
            "title": "Exact",
            "description": "Exact (brute-force) search, for V-04 only.",
            "default": false
          },
          "hnsw_ef": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1024.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Hnsw Ef"
          },
          "with_instruction": {
            "type": "boolean",
            "title": "With Instruction",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest"
      },
      "SearchResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/ScoredChunk"
            },
            "type": "array",
            "title": "Results"
          },
          "took_ms": {
            "type": "integer",
            "title": "Took Ms"
          }
        },
        "type": "object",
        "required": [
          "results",
          "took_ms"
        ],
        "title": "SearchResponse"
      },
      "SourceRef": {
        "properties": {
          "n": {
            "type": "integer",
            "title": "N"
          },
          "kind": {
            "type": "string",
            "enum": [
              "doc",
              "external"
            ],
            "title": "Kind"
          },
          "doc_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doc Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "page": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "cited": {
            "type": "boolean",
            "title": "Cited",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "n",
          "kind",
          "doc_id",
          "title",
          "section",
          "url",
          "page",
          "score",
          "cited"
        ],
        "title": "SourceRef",
        "description": "A numbered source: `[n]` in the answer maps to it (ARCHITECTURE §4, §6.3)."
      },
      "StepRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "node": {
            "type": "string",
            "title": "Node"
          },
          "agent": {
            "type": "string",
            "enum": [
              "supervisor",
              "docs",
              "research"
            ],
            "title": "Agent"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens",
            "default": 0
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens",
            "default": 0
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd",
            "default": 0.0
          },
          "detail": {
            "additionalProperties": true,
            "type": "object",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "id",
          "node",
          "agent",
          "duration_ms",
          "model",
          "input_tokens",
          "output_tokens",
          "cost_usd",
          "detail"
        ],
        "title": "StepRecord",
        "description": "One executed node (timeline, U-08)."
      },
      "Usage": {
        "properties": {
          "input_tokens": {
            "type": "integer",
            "title": "Input Tokens",
            "default": 0
          },
          "output_tokens": {
            "type": "integer",
            "title": "Output Tokens",
            "default": 0
          },
          "cost_usd": {
            "type": "number",
            "title": "Cost Usd",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "input_tokens",
          "output_tokens",
          "cost_usd"
        ],
        "title": "Usage"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
