# Copy to .env (`cp .env.example .env`) and fill in the secrets. `.env` is gitignored.
# Only ANTHROPIC_API_KEY is mandatory; every other value has a working default.

# --- Secrets ---------------------------------------------------------------------------
# [SECRET] Anthropic API key (only mandatory key)
ANTHROPIC_API_KEY=
# [SECRET] Postgres password. Dev-only default; change it outside a local machine.
POSTGRES_PASSWORD=odoo_rag_dev_password
# [SECRET, optional] Hugging Face token (the embedding model is public).
# Left commented on purpose: an empty value is passed through to TEI as-is.
# HF_TOKEN=
# [SECRET, optional] Full connection string. Leave empty to compose it from POSTGRES_*.
# DATABASE_URL=
# [SECRET, challenge E] Langfuse (profile `observability`)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=

# --- LLM per role (D-03) ----------------------------------------------------------------
LLM_MODEL_CONTEXTUALIZER=claude-haiku-5-5
LLM_MODEL_ROUTER=claude-haiku-5-5
LLM_MODEL_GRADER=claude-haiku-5-5
LLM_MODEL_REWRITER=claude-haiku-5-5
LLM_MODEL_DIRECT=claude-haiku-5-5
LLM_MODEL_GENERATOR=claude-sonnet-5-5
LLM_MODEL_RESEARCH=claude-sonnet-5-5
# Evaluation judge only (D-12)
LLM_MODEL_JUDGE=claude-opus-5-5
LLM_EFFORT_ROUTER=low
LLM_EFFORT_GRADER=low

# --- Embeddings: TEI + Qwen3 (D-04) ------------------------------------------------------
EMBEDDINGS_URL=http://embeddings:80
EMBEDDINGS_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDINGS_DIM=1024
# Applied to queries only, never to documents
EMBEDDINGS_QUERY_INSTRUCTION=Given a developer question about Odoo 19, retrieve relevant documentation passages that answer the question

# --- Qdrant (D-05) ----------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=odoo19_dev
QDRANT_HNSW_EF=128

# --- Postgres (D-08). Dev-only defaults ---------------------------------------------------
POSTGRES_USER=odoo_rag
POSTGRES_DB=odoo_rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Chunking (D-06) --------------------------------------------------------------------
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CHUNK_MIN_TOKENS=100

# --- Agent limits -----------------------------------------------------------------------
RETRIEVER_TOP_K=10
MAX_REWRITES=2
RESEARCH_MAX_ITERATIONS=4
HISTORY_MAX_TURNS=6
HISTORY_MAX_TOKENS=4000

# --- Feature flags (D-13) ---------------------------------------------------------------
# Human-in-the-loop before the external search (challenge D)
HITL_ENABLED=false
# dense | hybrid (challenge B)
RETRIEVER=dense
# none | qwen3 (challenge B)
RERANKER=none
# none | langfuse (challenge E)
TRACING=none
# ddgs | searxng (plan B)
SEARCH_PROVIDER=ddgs

# --- External tools: Odoo Forum (D-07) ---------------------------------------------------
SEARXNG_URL=http://searxng:8080
FORUM_ALLOWED_DOMAINS=www.odoo.com
SEARCH_TIMEOUT_S=10
READ_TIMEOUT_S=15
SEARCH_MAX_RETRIES=2
SEARCH_CACHE_TTL_S=3600
HTTP_USER_AGENT=odoo-rag-assistant/0.1 (+https://github.com/OWNER/finanzauto)

# --- Services ---------------------------------------------------------------------------
MAX_UPLOAD_MB=20
AGENT_URL=http://agent:8000
INGESTION_URL=http://ingestion:8001
LOG_LEVEL=INFO
