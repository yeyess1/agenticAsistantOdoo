  "cards": [
    {
      "dot": "cyan",
      "title": "Supervisor",
      "items": [
        "contextualize reescribe la pregunta con el historial del thread (memoria en Postgres)",
        "router elige docs, research o direct con salida estructurada"
      ]
    },
    {
      "dot": "emerald",
      "title": "Documentación",
      "items": [
        "grader evalúa todos los chunks en una sola llamada",
        "rewriter reintenta hasta MAX_REWRITES = 2; después delega a investigación"
      ]
    },
    {
      "dot": "rose",
      "title": "Investigación",
      "items": [
        "Con HITL_ENABLED=false confirm es pass-through; si se rechaza, responde direct_answer",
        "tools devuelve los resultados a research_llm, hasta RESEARCH_MAX_ITERATIONS = 4 vueltas"
      ]
    }
